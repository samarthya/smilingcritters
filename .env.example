# Smiling Critters — environment config template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run the interactive wizard:
#   python scripts/setup.py
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini (cloud fallback) ────────────────────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
# Generous quota — no credit card required.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama (local AI — private, no internet) ──────────────────────────────────
# Install: https://ollama.com
# Start  : ollama serve
# Models : ollama pull llama3.2   (3B, fast, ~2 GB)
#          ollama pull llama3.1:8b (8B, better quality, ~5 GB)
#
# WSL2 users: Ollama on Windows is reachable via the Windows host IP.
# Find it with:  cat /etc/resolv.conf | grep nameserver
# OLLAMA_BASE_URL=http://172.22.112.1:11434   # ← typical WSL2 host IP
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Optional overrides ────────────────────────────────────────────────────────
# DB location (default: data/smiling_critters.db relative to repo root)
# DB_PATH=/custom/path/smiling_critters.db

# Launcher port (default: 8501)
# SC_PORT=8501

# Launcher bind address (default: 0.0.0.0 = accessible on LAN for iPad)
# SC_ADDRESS=0.0.0.0
